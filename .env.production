# Production Environment Variables
# DO NOT COMMIT THIS FILE TO GIT

# Application
APP_ENV=production
APP_DEBUG=false

# Server (Render sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Security (REQUIRED - Generate strong random string)
SECRET_KEY=your-secure-random-key-here-min-32-chars

# Database (REQUIRED - Get from your PostgreSQL provider)
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sellflow
