{
  "name": "SellFlow — Social commerce operations",
  "short_name": "SellFlow",
  "description": "Orders, inventory, customers and payment reconciliation for social sellers in Bangladesh.",
  "id": "/",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F4F6FB",
  "theme_color": "#0B1628",
  "lang": "en",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "/icons/Icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/Icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/Icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/Icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Orders", "url": "/app/#/orders" },
    { "name": "Payments", "url": "/app/#/payments" },
    { "name": "Products", "url": "/app/#/products" }
  ]
}
