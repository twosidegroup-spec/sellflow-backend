# SELLFLOW Backend Environment Variables
# COPY this file to .env and fill in the values

# ==================== REQUIRED FOR PRODUCTION ====================
# The app REFUSES TO START in production when SECRET_KEY is missing,
# shorter than 32 characters, or a known placeholder.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-character-secret-key-here

# HMAC key for device-bridge pairing codes and device tokens.
# REQUIRED in production (fail-closed, same rule as SECRET_KEY).
# Outside production a random per-process key is used, so tokens do not
# survive a restart there (expected; see MIGRATION_REPORT.md).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_TOKEN_SECRET=

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/sellflow_db

# ==================== APP CONFIGURATION ====================
# Set to 'production' when deploying
APP_ENV=production

# Set to 'false' in production (for security)
APP_DEBUG=false

# ==================== CORS ====================
# Explicit comma-separated origin list. A literal '*' disables credentialed
# CORS automatically, so the unsafe wildcard+credentials combination cannot
# occur. Set the real mobile/web origins in production.
CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000,http://127.0.0.1

# ==================== REGISTRATION ====================
# Optional. When set, POST /api/v1/auth/register requires a matching
# invite_code (constant-time comparison). Leave empty for open registration.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
REGISTRATION_INVITE_CODE=

# ==================== CLOUD STORAGE (Optional) ====================
# Set these for Cloudflare R2, AWS S3, or compatible storage
# Leave empty to use local file storage (NOT recommended for production)
AWS_ACCESS_KEY_ID=your-cloud-key-id
AWS_SECRET_ACCESS_KEY=your-cloud-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ==================== FILE UPLOAD ====================
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/jpg
