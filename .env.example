# SELLFLOW Backend Environment Variables
# COPY this file to .env and fill in the values

# ==================== REQUIRED FOR PRODUCTION ====================
# Generate a strong secret key (run: openssl rand -hex 32)
SECRET_KEY=your-32-character-secret-key-here

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/sellflow_db

# ==================== APP CONFIGURATION ====================
# Set to 'production' when deploying
APP_ENV=production

# Set to 'false' in production (for security)
APP_DEBUG=false

# ==================== CORS ====================
# Your mobile app's domain (e.g., https://your-app.vercel.app)
# Development can use localhost
CORS_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000,http://127.0.0.1,*

# ==================== CLOUD STORAGE (Optional) ====================
# Set these for Cloudflare R2, AWS S3, or compatible storage
# Leave empty to use local file storage (NOT recommended for production)
AWS_ACCESS_KEY_ID=your-cloud-key-id
AWS_SECRET_ACCESS_KEY=your-cloud-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ==================== FILE UPLOAD ====================
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/jpg
